rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Publicly readable folders
    match /paddleImages/{allPaths=**} {
      allow read: if true;
    } 
    match /ballImages/{allPaths=**} {
      allow read: if true;
    }
    match /courtImages/{allPaths=**} {
      allow read: if true;
    }
    match /flooringImages/{allPaths=**} {
      allow read: if true;
    }
    match /companyLogos/{allPaths=**} {
      allow read: if true;
    }
    match /blogImages/{allPaths=**} {
      allow read: if true;
    }
    match /invoices/{allPaths=**} {
      allow read: if true;
    }
    match /tempUploads/{allPaths=**} {
      allow read: if true;
    }
    match /payment-receipts/{allPaths=**} {
      allow read: if true;
    }
    match /blogs/{allPaths=**} {
      allow read: if true;
    }
    
    // Default rules: Require auth for everything else
    match /{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
